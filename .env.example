# Environment Resource Naming (per AISE S0 §25.1)
# DATABASE_URL is a runtime alias — it points to the target authorized
# for the current execution context. It does NOT automatically mean Production.

# Explicit environment targets:
# PROD_DATABASE_URL=postgresql://user:password@neon-main-host/db?sslmode=require
# DEV_DATABASE_URL=postgresql://user:password@neon-dev-host/db?sslmode=require
# TEST_DATABASE_URL=postgresql://user:password@neon-test-host/db?sslmode=require

# Runtime alias — set this to the appropriate environment target:
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-32+-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap (set once on first deploy per environment, then can be removed)
FANTOMAS_INITIAL_PASSWORD=set-at-first-deploy-then-rotate
INITIAL_ADMIN_LOGIN=admin1
INITIAL_ADMIN_PASSWORD=set-at-first-deploy-then-rotate
INITIAL_ADMIN_EMAIL=admin1@jourdain.local
FANTOMAS_EMAIL=fantomas@jourdain.local

# Public site URL (for sitemap/SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
