# Environment Resource Naming (per AISE S0 §25.1)
# DATABASE_URL is a runtime alias — it points to the target authorized
# for the current execution context. It does NOT automatically mean Production.

# Explicit environment targets:
# PROD_DATABASE_URL=postgresql://user:password@neon-main-host/db?sslmode=require
# DEV_DATABASE_URL=postgresql://user:password@neon-dev-host/db?sslmode=require
# TEST_DATABASE_URL=postgresql://user:password@neon-test-host/db?sslmode=require

# Runtime alias — set this to the appropriate environment target:
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-32+-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# Fantomas break-glass session signing key (OPTION A per Fantomas mini-design)
# Independent of BETTER_AUTH_SECRET. Used as HMAC-SHA256 key for the
# self-verifying jourdain_fantomas_session cookie. 32+ bytes high-entropy
# base64 (e.g. `openssl rand -base64 32`). Rotation invalidates all active
# Fantomas sessions (by design).
FANTOMAS_SESSION_SECRET=generate-a-32+-byte-random-base64-string

# Bootstrap (set once on first deploy per environment, then can be removed)
FANTOMAS_INITIAL_PASSWORD=set-at-first-deploy-then-rotate
INITIAL_ADMIN_LOGIN=admin1
INITIAL_ADMIN_PASSWORD=set-at-first-deploy-then-rotate
INITIAL_ADMIN_EMAIL=admin1@jourdain.local
FANTOMAS_EMAIL=fantomas@jourdain.local

# Public site URL (for sitemap/SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E2E Test Infrastructure (WP-005)
# This variable is DOCUMENTATION ONLY in .env.example.
# It MUST NOT be the authoritative runtime source for the fingerprint.
# The actual authorized runtime value must come from the execution
# environment (.env.local for local developer runs, or explicitly
# injected process env for CI). The expected hostname is non-secret —
# it identifies a database resource, not credentials.
# The E2E runner positively verifies hostname(TEST_DATABASE_URL)
# equals E2E_EXPECTED_TEST_DATABASE_HOST before any mutation.
E2E_EXPECTED_TEST_DATABASE_HOST=
